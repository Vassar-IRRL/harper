<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="harper_ros2_control">
  <!--
    Single dual-arm ros2_control system.

    Launch (bringup.launch.py) passes:
      hardware_plugin, use_fake_hardware, bus_config, models_config, readonly

    Defaults keep mock hardware so description renders without Dynamixel ports.
    Same joint interfaces are used for mock, real, and future sim backends (sim2real).
  -->

  <xacro:arg name="hardware_plugin" default="mock_components/GenericSystem"/>
  <xacro:arg name="use_fake_hardware" default="true"/>
  <xacro:arg name="bus_config" default=""/>
  <xacro:arg name="models_config" default=""/>
  <xacro:arg name="readonly" default="true"/>

  <xacro:include filename="$(find harper_description)/urdf/ros2_control_macros.xacro"/>

  <ros2_control name="harper_system" type="system">
    <hardware>
      <plugin>$(arg hardware_plugin)</plugin>
      <xacro:if value="$(arg use_fake_hardware)">
        <param name="mock_sensor_commands">false</param>
      </xacro:if>
      <xacro:unless value="$(arg use_fake_hardware)">
        <param name="bus_config">$(arg bus_config)</param>
        <param name="models_config">$(arg models_config)</param>
        <param name="readonly">$(arg readonly)</param>
      </xacro:unless>
    </hardware>

    <!-- Left arm leads -->
    <xacro:harper_actuated_joint joint_name="left_shd_fex_joint"/>
    <xacro:harper_actuated_joint joint_name="left_shd_aad_joint"/>
    <xacro:harper_actuated_joint joint_name="left_shd_rot_joint"/>
    <xacro:harper_actuated_joint joint_name="left_elb_fex_joint"/>
    <xacro:harper_actuated_joint joint_name="left_fam_rot_joint"/>
    <xacro:harper_actuated_joint joint_name="left_wrs_fex_joint"/>
    <xacro:harper_actuated_joint joint_name="left_thb_mip_joint"/>
    <xacro:harper_actuated_joint joint_name="left_ind_mip_joint"/>
    <xacro:harper_actuated_joint joint_name="left_mid_mip_joint"/>
    <xacro:harper_actuated_joint joint_name="left_rng_mip_joint"/>
    <xacro:harper_actuated_joint joint_name="left_pnk_mip_joint"/>

    <!-- Left arm passive mimics -->
    <xacro:harper_mimic_state_joint joint_name="left_thb_ip_joint" lead_joint_name="left_thb_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="left_ind_pip_joint" lead_joint_name="left_ind_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="left_ind_dip_joint" lead_joint_name="left_ind_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="left_mid_pip_joint" lead_joint_name="left_mid_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="left_mid_dip_joint" lead_joint_name="left_mid_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="left_rng_pip_joint" lead_joint_name="left_rng_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="left_rng_dip_joint" lead_joint_name="left_rng_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="left_pnk_pip_joint" lead_joint_name="left_pnk_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="left_pnk_dip_joint" lead_joint_name="left_pnk_mip_joint"/>

    <!-- Right arm leads -->
    <xacro:harper_actuated_joint joint_name="right_shd_fex_joint"/>
    <xacro:harper_actuated_joint joint_name="right_shd_aad_joint"/>
    <xacro:harper_actuated_joint joint_name="right_shd_rot_joint"/>
    <xacro:harper_actuated_joint joint_name="right_elb_fex_joint"/>
    <xacro:harper_actuated_joint joint_name="right_fam_rot_joint"/>
    <xacro:harper_actuated_joint joint_name="right_wrs_fex_joint"/>
    <xacro:harper_actuated_joint joint_name="right_thb_mip_joint"/>
    <xacro:harper_actuated_joint joint_name="right_ind_mip_joint"/>
    <xacro:harper_actuated_joint joint_name="right_mid_mip_joint"/>
    <xacro:harper_actuated_joint joint_name="right_rng_mip_joint"/>
    <xacro:harper_actuated_joint joint_name="right_pnk_mip_joint"/>

    <!-- Right arm passive mimics -->
    <xacro:harper_mimic_state_joint joint_name="right_thb_ip_joint" lead_joint_name="right_thb_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="right_ind_pip_joint" lead_joint_name="right_ind_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="right_ind_dip_joint" lead_joint_name="right_ind_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="right_mid_pip_joint" lead_joint_name="right_mid_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="right_mid_dip_joint" lead_joint_name="right_mid_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="right_rng_pip_joint" lead_joint_name="right_rng_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="right_rng_dip_joint" lead_joint_name="right_rng_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="right_pnk_pip_joint" lead_joint_name="right_pnk_mip_joint"/>
    <xacro:harper_mimic_state_joint joint_name="right_pnk_dip_joint" lead_joint_name="right_pnk_mip_joint"/>
  </ros2_control>

  <!-- Transmissions for all 22 lead joints -->
  <xacro:simple_position_transmission joint_name="left_shd_fex_joint"/>
  <xacro:simple_position_transmission joint_name="left_shd_aad_joint"/>
  <xacro:simple_position_transmission joint_name="left_shd_rot_joint"/>
  <xacro:simple_position_transmission joint_name="left_elb_fex_joint"/>
  <xacro:simple_position_transmission joint_name="left_fam_rot_joint"/>
  <xacro:simple_position_transmission joint_name="left_wrs_fex_joint"/>
  <xacro:simple_position_transmission joint_name="left_thb_mip_joint"/>
  <xacro:simple_position_transmission joint_name="left_ind_mip_joint"/>
  <xacro:simple_position_transmission joint_name="left_mid_mip_joint"/>
  <xacro:simple_position_transmission joint_name="left_rng_mip_joint"/>
  <xacro:simple_position_transmission joint_name="left_pnk_mip_joint"/>
  <xacro:simple_position_transmission joint_name="right_shd_fex_joint"/>
  <xacro:simple_position_transmission joint_name="right_shd_aad_joint"/>
  <xacro:simple_position_transmission joint_name="right_shd_rot_joint"/>
  <xacro:simple_position_transmission joint_name="right_elb_fex_joint"/>
  <xacro:simple_position_transmission joint_name="right_fam_rot_joint"/>
  <xacro:simple_position_transmission joint_name="right_wrs_fex_joint"/>
  <xacro:simple_position_transmission joint_name="right_thb_mip_joint"/>
  <xacro:simple_position_transmission joint_name="right_ind_mip_joint"/>
  <xacro:simple_position_transmission joint_name="right_mid_mip_joint"/>
  <xacro:simple_position_transmission joint_name="right_rng_mip_joint"/>
  <xacro:simple_position_transmission joint_name="right_pnk_mip_joint"/>

</robot>
